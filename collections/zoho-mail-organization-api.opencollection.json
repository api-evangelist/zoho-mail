{
  "opencollection": "1.0.0",
  "info": {
    "name": "Zoho Mail Accounts Organization API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://accounts.zoho.com/oauth/v2/auth",
      "accessTokenUrl": "https://accounts.zoho.com/oauth/v2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Organization",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Admin update user account",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://mail.zoho.com/api/organization/:zoid/accounts/:accountId",
            "params": [
              {
                "name": "zoid",
                "value": "",
                "type": "path",
                "description": "The unique identifier for the organization."
              },
              {
                "name": "accountId",
                "value": "",
                "type": "path",
                "description": "The unique identifier for the email account."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://accounts.zoho.com/oauth/v2/auth",
              "accessTokenUrl": "https://accounts.zoho.com/oauth/v2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Admin endpoint to modify user account settings including display name, email address, forwarding, vacation reply, and mail processing sequence."
        }
      ]
    }
  ],
  "bundled": true
}